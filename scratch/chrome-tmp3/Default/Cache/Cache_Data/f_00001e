  // ===================== Generative Pattern-Mutation & Dynamischer Missions-Soundtrack =====================
  mutateCode(code,intensity=0.5){
    let src=String(code||this.currentCode||'');
    if(!src)return src;
    this.mutationCount++;
    const scales=['e:minor','f:minor','c:minor','d:phrygian','g:minor:pentatonic','a2:minor','b:minor','d:major:pentatonic','a:dorian','e:phrygian'];
    const pickScale=scales[(this.mutationCount+Math.floor(Math.random()*scales.length))%scales.length];

    // 1. Mutate scale
    src=src.replace(/(setScale|\.scale)\(\s*["'][^"']+["']\s*\)/g,`$1("${pickScale}")`);

    // 2. Randomly Mute / Un-Mute tracks ($VOICE: ⇄ _$VOICE:)
    const lines = src.split('\n');
    let mutedCount = 0;
    for(let i=0; i<lines.length; i++){
      const l = lines[i];
      // Already muted track: _$FOO: -> 55% chance to un-mute
      if(/^\s*_\$([A-Z0-9_]+)\s*:/.test(l)){
        if(Math.random() < 0.55){
          lines[i] = l.replace(/^\s*_\$([A-Z0-9_]+)\s*:/, '$$$1:');
        }
      }
      // Active track: $FOO: -> 28% chance to mute
      else if(/^\s*\$([A-Z0-9_]+)\s*:/.test(l)){
        if(Math.random() < 0.28 && mutedCount < 2){
          lines[i] = l.replace(/^\s*\$([A-Z0-9_]+)\s*:/, '_$$$1:');
          mutedCount++;
        }
      }
    }
    src = lines.join('\n');

    // 3. Ribbon injection / randomization
    const hasRib = /\.rib\s*\(\s*\d+/.test(src);
    if(hasRib){
      src=src.replace(/\.rib\(\s*\d+\s*,\s*\d+\s*\)/g, ()=>{
        const rSeed = 1 + Math.floor(Math.random()*64);
        const rLen = [2, 4, 8, 16][Math.floor(Math.random()*4)];
        return `.rib(${rSeed}, ${rLen})`;
      });
    } else {
      let injected = false;
      src = src.replace(/(\$(?:THEME|BASS|KICK|PATRON_BASS|SYNTH|LEAD)[^;\n]+\.s\([^)]+\))/g, (match)=>{
        if(!injected && Math.random() < 0.85){
          injected = true;
          const rSeed = 1 + Math.floor(Math.random()*64);
          const rLen = [2, 4, 8][Math.floor(Math.random()*3)];
          return `${match}.rib(${rSeed}, ${rLen})`;
        }
        return match;
      });
    }

    // 4. Random Scramble / Rev / Shuffle / Trancegate
    if(Math.random() < 0.45 && !src.includes('.rev()')){
      src = src.replace(/(\$THEME[^;\n]+)/, '$1.rev()');
    }
    if(Math.random() < 0.40 && !src.includes('.scramble()')){
      src = src.replace(/(\$BASS[^;\n]+)/, '$1.scramble()');
    }

    // 5. Randomly shuffle/permute numeric degree tokens inside n("<...>") or note("<...>")
    src=src.replace(/(?:n|note)\(\s*"<([^"<>]+)>"/g,(full,inner)=>{
      const tokens = inner.trim().split(/\s+/);
      if(tokens.length > 2 && Math.random() < 0.7){
        const mutatedTokens = tokens.map(tok => {
          if(/^\d+$/.test(tok) && Math.random() < 0.5){
            const val = parseInt(tok, 10);
            const shift = [-3, -2, -1, 1, 2, 3, 5][Math.floor(Math.random()*7)];
            return String(Math.max(0, val + shift));
          }
          return tok;
        });
        if(Math.random() < 0.4){
          for(let k=mutatedTokens.length-1; k>0; k--){
            const j=Math.floor(Math.random()*(k+1));
            [mutatedTokens[k], mutatedTokens[j]] = [mutatedTokens[j], mutatedTokens[k]];
          }
        }
        return full.replace(inner, mutatedTokens.join(' '));
      }
      return full;
    });

    // 6. Mutate slider(val) values toward mission intensity
    src=src.replace(/slider\(\s*(0?\.\d+|\d+(?:\.\d+)?)/g,(_,v)=>{
      const cur=parseFloat(v)||0.5;
      const delta=(Math.random()-0.42)*0.22+(intensity-0.5)*0.18;
      const next=Math.max(0.12,Math.min(0.98,cur+delta));
      return `slider(${next.toFixed(3)}`;
    });

    // 7. Adjust setCpm(bpm/4) dynamically
    src=src.replace(/setCpm\(\s*(\d+(?:\.\d+)?)\s*\/\s*4\s*\)/g,(_,bpm)=>{
      const base=parseFloat(bpm)||138;
      const mod=Math.round(Math.max(96,Math.min(182,base+(intensity-0.4)*18+(Math.random()-0.5)*12)));
      return `setCpm(${mod}/4)`;
    });

    return src;
  },

  // Passt den laufenden Soundtrack dynamisch an das Kampfgeschehen an
  updateMissionDynamics(combatState){
    if(!this.dynamicEnabled||!combatState||!combatState.active)return;
    const units=Object.values(combatState.units||{});
    const players=units.filter(u=>u.side==='player'&&!u.dead);
    const enemies=units.filter(u=>u.side==='enemy'&&!u.dead);
    const downed=players.filter(u=>u.downed).length;
    const avgHp=players.length?players.reduce((s,u)=>s+u.hp/Math.max(1,u.maxHp),0)/players.length:1;
    const hasBoss=enemies.some(e=>e.type==='goauld'||e.type==='queen');
    let tension=0.25;
    if(combatState.mission&&combatState.mission.peaceful)tension=0.1;
    else{
      tension=Math.min(1.0,0.25+(enemies.length*0.06)+(1-avgHp)*0.45+(downed*0.2)+(hasBoss?0.3:0));
    }
    this.tension=Math.round(tension*100)/100;
    // Choose fitting Switch Angel track or mutate every 3 rounds
    if(this.mode==='auto'&&this.useSwitchAngelAuto){
      let targetTrack=this.currentTrack;
      if(combatState.mission&&combatState.mission.peaceful){
        targetTrack='sa_curiosity_piano';
      }else if(hasBoss||tension>=0.78){
        const bossPool=['sa_did_i_make_this','sa_whoneedsa303','sa_dubstepacid','sa_amen_infinity'];
        targetTrack=bossPool[(combatState.round||1)%bossPool.length];
      }else{
        const combatPool=['sa_autotomatone','sa_extra_slippy','sa_909workout','sa_hotroller','sa_generative_jungle'];
        targetTrack=combatPool[(combatState.round||1)%combatPool.length];
      }
      if(targetTrack!==this.currentTrack&&STRUDEL_TRACKS[targetTrack]){
        this.currentTrack=targetTrack;
        const baseCode=STRUDEL_TRACKS[targetTrack].code;
        const dynCode=tension>0.55?this.mutateCode(baseCode,tension):baseCode;
        this.evaluate(dynCode,SFX&&!SFX.muted&&SFX.musicEnabled);
      }
    }
  },

  // Speichert einen editierten oder mutierten Song dauerhaft im Spielstand (S.customTracks)
  saveCustomTrack(title,code){
    const cleanTitle=String(title||'').trim()||`Switch Angel Remix #${this.mutationCount+1}`;
    const cleanCode=String(code||this.currentCode||'').trim();
    if(!cleanCode)return {ok:false,msg:'Kein Strudel-Code zum Speichern.'};
    const id='custom_'+Date.now();
    const entry={id,name:`💾 ${cleanTitle}`,title:cleanTitle,artist:'SGC Live-Remix',role:'custom',code:cleanCode};
    STRUDEL_TRACKS[id]=entry;
    this.patterns[id]=cleanCode;
    this.currentTrack=id;
    if(typeof S!=='undefined'&&S){
      if(!S.customTracks)S.customTracks={};
      S.customTracks[id]=entry;
      if(typeof save==='function')save();
    }
    return {ok:true,id,msg:`Track „${cleanTitle}“ im Spielstand gespeichert!`};
  },

  loadCustomTracksFromSave(){
    if(typeof S==='undefined'||!S||!S.customTracks)return;
    for(const [id,entry] of Object.entries(S.customTracks)){
      STRUDEL_TRACKS[id]=entry;
      this.patterns[id]=entry.code;
    }
  },

  _triggerCycle(cycleIdx,cycleDur){
    if(!SFX.ctx||SFX.muted||!SFX.musicEnabled)return;
    const now=SFX.ctx.currentTime;
    this.voices.forEach(v=>{
      if(v.kind==='chord'&&v.degreePattern){
        const baseChord=_CHORD_MAP[String(v.chordName||'cmaj7').toLowerCase()]||_CHORD_MAP.cmaj7;
        const degs=Array.isArray(v.degreePattern)?v.degreePattern:parseMiniNotation(v.degreePattern,cycleIdx).map(e=>e.val);
        const envs=Array.isArray(v.envPattern)?v.envPattern:null;
        const stepCount=degs.length||1,stepDur=cycleDur/stepCount;
        degs.forEach((d,i)=>{
          const env=envs?Number(envs[i]||0):1;
          if(env<=0||d===null||d===undefined)return;
          const degNum=Number(d)||0;
          const midi=baseChord[Math.abs(degNum)%baseChord.length]+Math.floor(degNum/baseChord.length)*12;
          this._scheduleNote(now+i*stepDur,Math.max(0.05,stepDur*0.85),midi,v,env);
        });
        return;
      }
      const evs=parseMiniNotation(v.pattern,cycleIdx);
      evs.forEach(ev=>{
        const startT=now+ev.offset*cycleDur;
        const dur=Math.max(0.03,ev.dur*cycleDur/Math.max(0.25,v._fast)*v._slow);
        if(v.kind==='sound'){
          const tok=String(ev.val||'').trim().toLowerCase();
          if(!tok||tok==='~'||tok==='-'||tok==='0')return;
          SFX._playStrudelNoise(startT,Math.min(dur,v._decay||0.06),v._gain,v._lpf,tok);
        }else{
          const midi=_parseNoteToken(ev.val,v.scaleName);
          if(midi===null)return;
          this._scheduleNote(startT,dur,midi+(v.transposeSemi||0),v,1);
        }
      });
    });
  },

  _scheduleNote(startT,dur,midi,v,vel){
    if(!SFX.ctx||!SFX.musicGain)return;
    const ctx=SFX.ctx;
    const is8Bit=this.chiptuneMode;
    const rb=SFX.rebirth||{bassBank:'tb303_saw',cutoff:2400,resonance:6.0,envMod:0.6,decay:0.28,distortion:0.2,tune:0};

    const sName=String(v.synth||'triangle').toLowerCase();
    const isBass=sName.includes('bass')||sName.includes('303')||sName.includes('acid')||(v.kind==='note'&&midi<58);

    if(isBass){
      STRUDEL.onVoiceTrigger('bass',midi);
      midi+=Number(rb.tune||0);
    }else{
      STRUDEL.onVoiceTrigger('melody',midi);
    }

    const freq=_midiToFreq(midi);
    const osc=ctx.createOscillator();
    const filt=ctx.createBiquadFilter();
    const g=ctx.createGain();

    let synth='triangle';
    if(is8Bit||(isBass&&rb.bassBank==='chiptune')){
      synth='square';
    }else if(isBass){
      if(rb.bassBank==='tb303_sq') synth='square';
      else if(rb.bassBank==='sub') synth='sine';
      else if(rb.bassBank==='slap') synth='triangle';
      else synth='sawtooth'; // tb303_saw, sh101, reese
    }else{
      synth=sName.includes('saw')?'sawtooth':(sName==='pulse'||sName==='square'?'square':(sName==='sine'?'sine':'triangle'));
    }
    osc.type=synth;
    osc.frequency.setValueAtTime(Math.max(24,Math.min(12000,freq)),startT);

    if((is8Bit||(isBass&&rb.bassBank==='chiptune'))&&dur>0.08){
      const arpSemitones=[0,4,7,12];
      const stepT=0.025;
      for(let t=stepT,idx=1;t<dur*0.75;t+=stepT,idx++){
        const shift=arpSemitones[idx%arpSemitones.length];
        osc.frequency.setValueAtTime(_midiToFreq(midi+shift),startT+t);
      }
      osc.frequency.setValueAtTime(freq,startT+dur*0.75);
    }else if(v._slide){
      osc.frequency.exponentialRampToValueAtTime(Math.max(24,freq+v._slide),startT+dur);
    }

    filt.type='lowpass';
    if(isBass&&!is8Bit){
      const cut=rb.cutoff||2400;
      const em=rb.envMod!==undefined?rb.envMod:0.6;
      filt.frequency.setValueAtTime(cut,startT);
      filt.frequency.linearRampToValueAtTime(Math.min(11000,cut*(1+em*2.8)),startT+0.015);
      filt.frequency.exponentialRampToValueAtTime(Math.max(30,cut),startT+Math.min(dur,rb.decay||0.28));
      filt.Q.setValueAtTime(Math.max(0.5,rb.resonance||6),startT);
    }else{
      filt.frequency.setValueAtTime(is8Bit?4200:(v._lpf||1800),startT);
    }

    const peak=Math.max(0.001,Math.min(0.45,(v._gain||0.15)*(vel||1)));
    const atk=is8Bit?0.003:Math.min(dur*0.4,v._attack||0.01);
    const dec=is8Bit?Math.min(dur*0.5,0.08):Math.min(dur*0.6,v._decay||0.15);
    const sus=Math.max(0.001,peak*(v._sustain!==undefined?v._sustain:0.15));
    g.gain.setValueAtTime(0.0001,startT);
    g.gain.linearRampToValueAtTime(peak,startT+atk);
    g.gain.exponentialRampToValueAtTime(sus,startT+atk+dec);
    g.gain.exponentialRampToValueAtTime(0.0001,startT+dur+(v._release||0.05));
    osc.connect(filt);
    filt.connect(g);

    if(isBass&&SFX.distortionNode){
      g.connect(SFX.distortionNode);
    }else{
      g.connect(SFX.musicGain);
    }

    if(v._delay>0&&SFX.delayNode){
      g.connect(SFX.delayNode);
    }
    osc.start(startT);
    osc.stop(startT+dur+(v._release||0.05)+0.02);
  }
};

const SFX={
  ctx:null, master:null, musicGain:null, delayNode:null,
  bassFilter:null, distortionNode:null,
  muted:false, musicEnabled:true, volume:0.65, strudel:STRUDEL,
  tracks:STRUDEL_TRACKS,
  rebirth:{
    bassBank:'tb303_saw',
    kickBank:'tr909',
    hatBank:'tr909',
    cutoff:2400,
    resonance:6.0,
    envMod:0.60,
    decay:0.28,
    distortion:0.20,
    tune:0,
    bdTune:115,
    bdDecay:0.24,
    hatDecay:0.08,
    tempoBpm:140
  },

  setVolume(val){
    const v=Math.max(0,Math.min(1.0,parseFloat(val)));
    this.volume=v;
    if(this.master&&this.ctx){
      this.master.gain.setValueAtTime(this.muted?0:v,this.ctx.currentTime);
    }
    try{localStorage.setItem('sgc_volume',String(v));}catch(e){}
    return v;
  },

  getVolume(){
    if(typeof localStorage!=='undefined'){
      const s=localStorage.getItem('sgc_volume');
      if(s!==null){
        const pv=parseFloat(s);
        if(!isNaN(pv))return pv;
      }
    }
    return this.volume!==undefined?this.volume:0.65;
  },

  setSoundBank(type, bankId){
    if(!this.rebirth)return;
    if(type==='kick') this.rebirth.kickBank=bankId;
    else if(type==='hat') this.rebirth.hatBank=bankId;
    else if(type==='bass') this.rebirth.bassBank=bankId;
    if(typeof updateRebirthUI==='function') updateRebirthUI();
    if(typeof toast==='function'){
      const name = type==='kick'?'Kick':type==='hat'?'Hi-Hat':'Bass';
      toast(`🔊 ${name}-Soundbank: ${bankId.toUpperCase()}`);
    }
  },

  setRebirthParam(param, val){
    if(!this.rebirth)return;
    const num=Number(val);
    if(isNaN(num))return;
    this.rebirth[param]=num;
    if(this.ctx){
      const now=this.ctx.currentTime;
      if(param==='cutoff'&&this.bassFilter){
        this.bassFilter.frequency.setTargetAtTime(Math.max(40,Math.min(10000,num)),now,0.01);
      }else if(param==='resonance'&&this.bassFilter){
        this.bassFilter.Q.setTargetAtTime(Math.max(0.1,Math.min(25,num)),now,0.01);
      }else if(param==='distortion'&&this.distortionNode){
        this.distortionNode.curve=_makeDistortionCurve(num*50);
      }else if(param==='tempoBpm'){
        STRUDEL.setCpm(num/4);
      }
    }
    if(typeof updateRebirthParamReadout==='function') updateRebirthParamReadout(param,num);
  },

  init(){
    if(this.ctx||typeof window==='undefined')return;
    try{
      const AudioContextClass=window.AudioContext||window.webkitAudioContext;
      if(!AudioContextClass)return;
      this.ctx=new AudioContextClass();
      const currentVol=this.getVolume();
      this.master=this.ctx.createGain();
      this.master.gain.value=this.muted?0:currentVol;

      this.analyser=this.ctx.createAnalyser();
      this.analyser.fftSize=512;
      this.analyser.smoothingTimeConstant=0.8;
      this.master.connect(this.analyser);
      this.analyser.connect(this.ctx.destination);

      // Route any third-party Web Audio nodes (Superdough / Strudel Web) directly through Master Gain & Analyser
      if(!AudioNode.prototype._sgcHooked){
        AudioNode.prototype._sgcHooked=true;
        const origConnect=AudioNode.prototype.connect;
        const self=this;
        AudioNode.prototype.connect=function(dest,...args){
          if(dest&&self&&self.ctx&&dest===self.ctx.destination&&this!==self.analyser&&this!==self.master){
            return origConnect.call(this,self.master,...args);
          }
          return origConnect.call(this,dest,...args);
        };
      }

      this.musicGain=this.ctx.createGain();
      this.musicGain.gain.value=this.musicEnabled?0.48:0;
      this.musicGain.connect(this.master);

      // ReBirth TB-303 Bass DSP chain (Filter -> Waveshaper Distortion -> Master Music Gain)
      this.bassFilter=this.ctx.createBiquadFilter();
      this.bassFilter.type='lowpass';
      this.bassFilter.frequency.value=this.rebirth.cutoff||2400;
      this.bassFilter.Q.value=this.rebirth.resonance||6.0;

      this.distortionNode=this.ctx.createWaveShaper();
      this.distortionNode.curve=_makeDistortionCurve((this.rebirth.distortion||0.2)*50);
      this.distortionNode.oversample='4x';

      this.bassFilter.connect(this.distortionNode);
      this.distortionNode.connect(this.musicGain);

      this.delayNode=this.ctx.createDelay(1.0);
      this.delayNode.delayTime.value=0.28;
      const fb=this.ctx.createGain();
      fb.gain.value=0.24;
      const df=this.ctx.createBiquadFilter();
      df.type='lowpass';df.frequency.value=1400;
      this.delayNode.connect(df);
      df.connect(fb);
      fb.connect(this.delayNode);
      df.connect(this.musicGain);

      STRUDEL.loadCustomTracksFromSave();
      STRUDEL.ensureWebRepl().then(()=>{
        if(!this.muted&&this.musicEnabled){
          this.playTrack(STRUDEL.currentTrack||'sa_lets_talk');
        }
      });
    }catch(e){
      this.ctx=null;
      console.error('[SFX] AudioContext initialization failed:',e);
    }
  },

  resume(){
    if(!this.ctx)return Promise.resolve();
    const resumed=this.ctx.state==='suspended'?this.ctx.resume():Promise.resolve();
    return resumed.then(()=>{
      if(!STRUDEL.playing&&this.musicEnabled&&!this.muted){
        this.playTrack(STRUDEL.currentTrack||'sa_lets_talk');
      }
    });
  },

  stop(){
    STRUDEL.hush();
    STRUDEL.playing=false;
    STRUDEL.paused=false;
    if(typeof updateWinampDisplay==='function')updateWinampDisplay();
  },

  pause(){
    if(STRUDEL.playing){
      STRUDEL.hush();
      STRUDEL.paused=true;
    }else if(STRUDEL.paused){
      STRUDEL.paused=false;
      this.playTrack(STRUDEL.currentTrack||'sa_lets_talk');
    }
    if(typeof updateWinampDisplay==='function')updateWinampDisplay();
  },

  prevTrack(){
    const keys=Object.keys(STRUDEL_TRACKS);
    const idx=keys.indexOf(STRUDEL.currentTrack);
    const prev=keys[(idx-1+keys.length)%keys.length];
    this.playTrack(prev);
  },

  nextTrack(){
    const keys=Object.keys(STRUDEL_TRACKS);
    const idx=keys.indexOf(STRUDEL.currentTrack);
    const next=keys[(idx+1)%keys.length];
    this.playTrack(next);
  },

  toggle(){
    this.muted=!this.muted;
    if(this.master)this.master.gain.value=this.muted?0:0.55;
    if(this.muted)STRUDEL.hush();
    else if(this.musicEnabled)this.playTrack(STRUDEL.currentTrack||'sa_lets_talk');
    if(typeof updateWinampDisplay==='function')updateWinampDisplay();
    return this.muted;
  },

  toggleMusic(){
    this.musicEnabled=!this.musicEnabled;
    if(this.musicGain)this.musicGain.gain.value=this.musicEnabled?0.48:0;
    if(!this.musicEnabled)STRUDEL.hush();
    else if(!this.muted)this.playTrack(STRUDEL.currentTrack||'sa_lets_talk');
    if(typeof updateWinampDisplay==='function')updateWinampDisplay();
    return this.musicEnabled;
  },

  playTrack(trackKey){
    STRUDEL.paused=false;
    STRUDEL.loadCustomTracksFromSave();
    if(trackKey==='custom'&&STRUDEL.customCode){
      STRUDEL.currentTrack='custom';
      STRUDEL.evaluate(STRUDEL.customCode,!this.muted&&this.musicEnabled);
      if(typeof updateWinampDisplay==='function')updateWinampDisplay();
      return;
    }
    const tr=STRUDEL_TRACKS[trackKey]||STRUDEL_TRACKS.sa_lets_talk||STRUDEL_TRACKS.base;
    STRUDEL.currentTrack=STRUDEL_TRACKS[trackKey]?trackKey:'base';
    STRUDEL.evaluate(tr.code,!this.muted&&this.musicEnabled);
    if(typeof updateWinampDisplay==='function')updateWinampDisplay();
  },

  setTrackMode(mode){
    STRUDEL.mode=mode||'auto';
    if(STRUDEL.mode!=='auto'){
      this.playTrack(STRUDEL.mode);
    }else{
      this.syncContext(this._lastContext||'base');
    }
  },

  syncContext(contextKey){
    this._lastContext=contextKey;
    if(STRUDEL.mode!=='auto')return;
    // Map contextKey ('base', 'map', 'planet', 'gate', 'combat', 'peaceful', 'boss') to Switch Angel or SGC track
    let target=contextKey;
    if(STRUDEL.useSwitchAngelAuto&&typeof SWITCH_ANGEL_TRACKS!=='undefined'){
      const roleMap={
        base:['sa_lets_talk','sa_patronbeat','sa_waning_pad','theme_remix_lofi'],
        map:['sa_its_giving_tycho','sa_sky_looks_back','theme_remix_1'],
        planet:['sa_canyonhopper','sa_openup','sa_mutek4am','sa_sentimental_dnb'],
        gate:['sa_in_the_beginning','theme_fanfare'],
        combat:['theme_remix_2','theme_remix_cnc','sa_autotomatone','sa_extra_slippy','sa_909workout','sa_hotroller','sa_generative_jungle','sa_amen_infinity'],
        peaceful:['theme_remix_lofi','sa_curiosity_piano'],
        boss:['theme_remix_cnc','sa_did_i_make_this','sa_whoneedsa303','sa_dubstepacid']
      };
      const pool=roleMap[contextKey];
      if(pool&&pool.length){
        const daySeed=(typeof S!=='undefined'&&S&&S.day)||1;
        target=pool[(daySeed-1)%pool.length];
      }
    }
    if(STRUDEL.currentTrack!==target||!STRUDEL.playing){
      this.playTrack(target);
    }
  },
  music(trackKey){
    this.syncContext(trackKey);
  },

  evalCustomPattern(code){
    STRUDEL.customCode=String(code||'');
    STRUDEL.mode='custom';
    this.init();this.resume();
    STRUDEL.evaluate(STRUDEL.customCode,true);
  },

  _playStrudelNoise(startT,dur,vol,filterFreq,kind){
    if(!this.ctx||this.muted||!this.musicGain)return;
    const k=String(kind||'white').split(':')[0];
    const rb=this.rebirth||{kickBank:'tr909',hatBank:'tr909',bdTune:115,bdDecay:0.24,hatDecay:0.08};

    // --- KICK DRUM ENGINE (TR-909 / TR-808 / TR-707 / Linn / 8-Bit / Acoustic / Acid) ---
    if(k==='bd'||k==='sbd'||k==='lt'||k.includes('kick')){
      STRUDEL.onVoiceTrigger('kick',36);
      const bank=rb.kickBank||'tr909';
      const o=this.ctx.createOscillator();
      const g=this.ctx.createGain();
      const tune=rb.bdTune||115;
      const decay=rb.bdDecay||0.24;

      if(bank==='tr808'){
        // Roland TR-808: Deep booming sine wave sub drop
        o.type='sine';
        o.frequency.setValueAtTime(Math.max(30,tune*0.88),startT);
        o.frequency.exponentialRampToValueAtTime(32,startT+Math.min(0.8,decay*1.5));
        g.gain.setValueAtTime(Math.min(0.48,(vol||0.25)*2.4),startT);
        g.gain.exponentialRampToValueAtTime(0.001,startT+Math.min(0.9,decay*1.6));
        o.connect(g);g.connect(this.musicGain);
        o.start(startT);o.stop(startT+Math.min(0.92,decay*1.62));
      }else if(bank==='tr707'){
        // Roland TR-707: Tight punchy digital 80s kick
        o.type='triangle';
        o.frequency.setValueAtTime(130,startT);
        o.frequency.exponentialRampToValueAtTime(52,startT+0.14);
        g.gain.setValueAtTime(Math.min(0.42,(vol||0.25)*2.1),startT);
        g.gain.exponentialRampToValueAtTime(0.001,startT+0.17);
        o.connect(g);g.connect(this.musicGain);
        o.start(startT);o.stop(startT+0.18);
      }else if(bank==='linn'){
        // LinnDrum: Crisp vintage attack with mid punch
        o.type='triangle';
        o.frequency.setValueAtTime(145,startT);
        o.frequency.exponentialRampToValueAtTime(48,startT+0.18);
        g.gain.setValueAtTime(Math.min(0.45,(vol||0.25)*2.2),startT);
        g.gain.exponentialRampToValueAtTime(0.001,startT+0.22);
        o.connect(g);g.connect(this.musicGain);
        o.start(startT);o.stop(startT+0.23);
      }else if(bank==='chiptune'){
        // 8-Bit NES Kick: Rapid descending square chirp
        o.type='square';
        o.frequency.setValueAtTime(160,startT);
        o.frequency.setValueAtTime(110,startT+0.015);
        o.frequency.setValueAtTime(70,startT+0.035);
        o.frequency.setValueAtTime(45,startT+0.065);
        g.gain.setValueAtTime(Math.min(0.35,(vol||0.25)*1.8),startT);
        g.gain.exponentialRampToValueAtTime(0.001,startT+0.12);
        o.connect(g);g.connect(this.musicGain);
        o.start(startT);o.stop(startT+0.13);
      }else if(bank==='acoustic'){
        // Acoustic Orchestral Timpani Kick
        o.type='sine';
        o.frequency.setValueAtTime(95,startT);
        o.frequency.exponentialRampToValueAtTime(42,startT+decay);
        g.gain.setValueAtTime(Math.min(0.45,(vol||0.25)*2.3),startT);
        g.gain.exponentialRampToValueAtTime(0.001,startT+decay+0.05);
        o.connect(g);g.connect(this.musicGain);
        o.start(startT);o.stop(startT+decay+0.06);
      }else if(bank==='acid'){
        // Saturated Acid Gabber Kick
        o.type='sawtooth';
        o.frequency.setValueAtTime(160,startT);
        o.frequency.exponentialRampToValueAtTime(38,startT+decay);
        g.gain.setValueAtTime(Math.min(0.5,(vol||0.25)*2.5),startT);
        g.gain.exponentialRampToValueAtTime(0.001,startT+decay+0.04);
        o.connect(g);
        if(this.distortionNode){o.connect(this.distortionNode);}
        else{o.connect(this.musicGain);}
        o.start(startT);o.stop(startT+decay+0.05);
      }else{
        // Roland TR-909 (Standard): Punchy club beater + triangle body
        o.type='triangle';
        o.frequency.setValueAtTime(Math.max(40,tune),startT);
        o.frequency.exponentialRampToValueAtTime(40,startT+decay);
        g.gain.setValueAtTime(Math.min(0.45,(vol||0.25)*2.3),startT);
        g.gain.exponentialRampToValueAtTime(0.001,startT+decay+0.04);
        o.connect(g);g.connect(this.musicGain);
        o.start(startT);o.stop(startT+decay+0.05);
      }
      return;
    }

    // --- HI-HAT ENGINE (TR-909 / TR-808 / TR-707 / Linn / 8-Bit / Noise Sweep) ---
    if(k==='hh'||k==='oh'||k==='noisehat'||k.includes('hat')){
      STRUDEL.onVoiceTrigger('hat',42);
      const bank=rb.hatBank||'tr909';
      const hatDec=rb.hatDecay||(k==='oh'?0.22:0.08);
      const n=Math.max(16,Math.floor(this.ctx.sampleRate*Math.min(dur,hatDec)));
      const buf=this.ctx.createBuffer(1,n,this.ctx.sampleRate);
      const d=buf.getChannelData(0);

      if(bank==='chiptune'){
        // 4-bit LFSR noise
        let lfsr=0x7ace;
        for(let i=0;i<n;i++){
          lfsr=(lfsr>>1)^(-(lfsr&1)&0xb400);
          d[i]=((lfsr&0x0f)/7.5-1)*(1-i/n);
        }
      }else{
        for(let i=0;i<n;i++){
          d[i]=(Math.random()*2-1)*Math.pow(1-i/n,1.5);
        }
      }

      const src=this.ctx.createBufferSource();src.buffer=buf;
      const f=this.ctx.createBiquadFilter();
      if(bank==='tr808'){
        // Roland TR-808: Metallic bandpass sizzle centered at 7200Hz, high Q
        f.type='bandpass';
        f.frequency.value=7200;
        f.Q.value=4.5;
      }else if(bank==='tr707'){
        f.type='highpass';
        f.frequency.value=6000;
      }else if(bank==='linn'){
        f.type='bandpass';
        f.frequency.value=8200;
        f.Q.value=2.2;
      }else{
        // Roland TR-909: Crisp highpassed noise at 8500Hz
        f.type='highpass';
        f.frequency.value=8500;
      }

      const g=this.ctx.createGain();
      g.gain.setValueAtTime(Math.max(0.001,(vol||0.04)*(bank==='tr808'?1.8:1.2)),startT);
      g.gain.exponentialRampToValueAtTime(0.0001,startT+Math.min(dur,hatDec));
      src.connect(f);f.connect(g);g.connect(this.musicGain);
      src.start(startT);
      return;
    }

    // --- SNARE / CLAP ---
    if(k==='sd'||k==='cp'||k==='snare'||k==='rim'){
      STRUDEL.onVoiceTrigger('snare',38);
    }

    const n=Math.max(16,Math.floor(this.ctx.sampleRate*dur));
    const buf=this.ctx.createBuffer(1,n,this.ctx.sampleRate),d=buf.getChannelData(0);
    let b0=0;
    for(let i=0;i<n;i++){
      const w=(Math.random()*2-1)*(1-i/n);
      b0=k==='pink'||k==='brown'?(0.85*b0+0.15*w):w;
      d[i]=b0;
    }
    const src=this.ctx.createBufferSource();src.buffer=buf;
    const f=this.ctx.createBiquadFilter();f.type='lowpass';f.frequency.value=filterFreq||2500;
    const g=this.ctx.createGain();
    g.gain.setValueAtTime(Math.max(0.001,vol||0.04),startT);
    g.gain.exponentialRampToValueAtTime(0.0001,startT+dur);
    src.connect(f);f.connect(g);g.connect(this.musicGain);
    src.start(startT);
  },

  tone(freq,dur,type,vol,slideTo){
    if(!this.ctx||this.muted)return;type=type||'square';vol=vol||0.3;
    const t=this.ctx.currentTime,o=this.ctx.createOscillator(),g=this.ctx.createGain();
    o.type=type;o.frequency.setValueAtTime(freq,t);
    if(slideTo)o.frequency.exponentialRampToValueAtTime(Math.max(1,slideTo),t+dur);
    g.gain.setValueAtTime(vol,t);g.gain.exponentialRampToValueAtTime(0.001,t+dur);
    o.connect(g);g.connect(this.master);o.start(t);o.stop(t+dur+0.02);
  },
  noise(dur,vol,filterFreq){
    if(!this.ctx||this.muted)return;vol=vol||0.3;filterFreq=filterFreq||1000;
    const t=this.ctx.currentTime,n=Math.floor(this.ctx.sampleRate*dur);
    const buf=this.ctx.createBuffer(1,n,this.ctx.sampleRate),d=buf.getChannelData(0);
    for(let i=0;i<n;i++)d[i]=(Math.random()*2-1)*(1-i/n);
    const src=this.ctx.createBufferSource();src.buffer=buf;
    const f=this.ctx.createBiquadFilter();f.type='lowpass';f.frequency.value=filterFreq;
    const g=this.ctx.createGain();g.gain.setValueAtTime(vol,t);g.gain.exponentialRampToValueAtTime(0.001,t+dur);
    src.connect(f);f.connect(g);g.connect(this.master);src.start(t);
  },
  shoot(){ this.noise(0.12,0.25,3000); this.tone(880,0.1,'square',0.15,220); },
  shotgun(){ this.noise(0.2,0.4,1500); this.tone(220,0.15,'square',0.2,80); },
  zat(){ this.tone(1400,0.14,'sine',0.22,320); this.tone(700,0.12,'triangle',0.15,1600); },
  staff(){ this.noise(0.18,0.3,1200); this.tone(360,0.18,'sawtooth',0.22,95); },
  turret(){ this.noise(0.09,0.22,3500); this.tone(640,0.08,'square',0.16,180); },
  melee(){ this.tone(150,0.12,'sine',0.35,60); this.noise(0.08,0.2,800); },
  hit(){ this.tone(300,0.08,'sawtooth',0.25,100); this.noise(0.06,0.15,2000); },
  miss(){ this.noise(0.15,0.1,4000); this.tone(600,0.15,'sine',0.08,900); },
  death(){ this.tone(200,0.4,'sawtooth',0.3,40); this.noise(0.3,0.2,600); },
  special(){ this.tone(520,0.12,'sine',0.22,880); setTimeout(()=>this.tone(880,0.16,'triangle',0.18,1180),80); },
  gate(){
    if(!this.ctx||this.muted)return;
    const t=this.ctx.currentTime,o=this.ctx.createOscillator(),g=this.ctx.createGain();
    o.type='sine';o.frequency.setValueAtTime(80,t);
    o.frequency.exponentialRampToValueAtTime(600,t+0.8);
    o.frequency.exponentialRampToValueAtTime(120,t+1.6);
    g.gain.setValueAtTime(0.001,t);
    g.gain.exponentialRampToValueAtTime(0.3,t+0.4);
    g.gain.exponentialRampToValueAtTime(0.001,t+1.8);
    o.connect(g);g.connect(this.master);o.start(t);o.stop(t+1.9);
    this.noise(1.2,0.1,800);
  },
  click(){ this.tone(1200,0.04,'square',0.1); },
  build(){ this.tone(400,0.1,'square',0.15,600); this.noise(0.1,0.1,1000); },
  victory(){ [523,659,784,1047].forEach((f,i)=>setTimeout(()=>this.tone(f,0.25,'square',0.2),i*120)); },
  defeat(){ [400,350,300,200].forEach((f,i)=>setTimeout(()=>this.tone(f,0.3,'sawtooth',0.2),i*150)); },
};

