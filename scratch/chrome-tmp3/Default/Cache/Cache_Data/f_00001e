    // Extend String & Number prototypes safely for mini-notation chaining in fallback compiler
    if(!String.prototype._saPatched){
      Object.defineProperty(String.prototype,'_saPatched',{value:true});
      ['sub','add','mul','div','seg','rib','ribbon','as'].forEach(m=>{
        if(!String.prototype[m])Object.defineProperty(String.prototype,m,{value:function(){return String(this);},configurable:true});
      });
    }
    if(!Number.prototype._saPatched){
      Object.defineProperty(Number.prototype,'_saPatched',{value:true});
      ['mul','add','sub','div','pow','rib','ribbon','fast','slow','range'].forEach(m=>{
        if(!Number.prototype[m])Object.defineProperty(Number.prototype,m,{value:function(b){
          if(m==='mul')return Number(this)*(Number(b)||1);
          if(m==='add')return Number(this)+(Number(b)||0);
          if(m==='sub')return Number(this)-(Number(b)||0);
          if(m==='pow')return Math.pow(Number(this),Number(b)||1);
          return Number(this);
        },configurable:true});
      });
    }
    const note=p=>{const v=new StrudelVoice('note',p);collected.push(v);return v;};
    const n=p=>{const v=new StrudelVoice('n',p);collected.push(v);return v;};
    const chord=p=>{const v=new StrudelVoice('chord',p);collected.push(v);return v;};
    const s=p=>{const v=new StrudelVoice('sound',p);v.synth=String(p||'white').split(/[*!:,/]/)[0].trim();collected.push(v);return v;};
    const sound=s;
