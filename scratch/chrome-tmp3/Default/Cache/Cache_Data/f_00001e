      range:(a,b)=>({slow:()=>(a+b)/2,fast:()=>(a+b)/2,mul:()=>(a+b)/2}),
      fast:()=>sigObj,slow:()=>sigObj,rib:()=>sigObj,ribbon:()=>sigObj,
      mul:()=>sigObj,div:()=>sigObj,add:()=>sigObj,sub:()=>sigObj,seg:()=>sigObj,seed:()=>sigObj,mod:()=>sigObj
    };
    // Transpile muted _$NAME: blocks out and convert $NAME: / $: into __v(expr)
    let jsSrc=src.replace(/^\s*_\$[A-Za-z0-9_]*\s*:[\s\S]*?(?=^\s*(?:_\$|\$[A-Za-z0-9_]*\s*:|const\s+|let\s+|setCpm|setcps|all\s*\()|\s*$)/gm,'');
    jsSrc=jsSrc.replace(/^\s*\$[A-Za-z0-9_]*\s*:\s*/gm,'__v=');
    try{
      const fn=new Function(
        '__v','setcps','setCps','setCpm','setcpm','setTempo','setScale','slider','all','postgain','register','samples','pk',
        'stack','cat','seq','blockArrange','note','n','chord','s','sound','hush',
        'sine','tri','saw','square','rand','irand','perlin','time','rev','iter',
        'G2','D3','C2','A2','E2','F2',
