    const cat=(...items)=>stack(...items);
    const seq=(...items)=>stack(...items);
    const blockArrange=(arr)=>stack(...(Array.isArray(arr)?arr.map(x=>Array.isArray(x)?x[0]:x).flat():[]));
    const setcps=v=>this.setcps(v);
    const setCps=v=>this.setcps(v);
    const setCpm=v=>this.setCpm(v);
    const setcpm=v=>this.setCpm(v);
    const setTempo=v=>this.setTempo(v);
    const setScale=sc=>{this._currentScale=String(sc||'e:minor');};
    const slider=(v)=>makeProxyNum(v);
    const all=()=>this;
    const postgain=v=>v;
    const register=()=>this;
    const samples=()=>Promise.resolve();
    const pk=(...args)=>args[0]||'Dm';
